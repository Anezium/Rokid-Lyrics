<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="8dp">

    <Button
        android:id="@+id/btnSpotifyWebLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/spotify_dialog_web_login"
        android:textColor="@color/phosphor_dim"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.14"
        android:background="@drawable/btn_outline_green"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:gravity="center"
        android:stateListAnimator="@null"
        android:textAllCaps="false" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/spotify_dialog_message"
        android:textColor="@color/phosphor_dim"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp" />

    <EditText
        android:id="@+id/editSpotifySpDc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:autofillHints="password"
        android:hint="@string/spotify_dialog_hint"
        android:textColor="@color/phosphor_text_bright"
        android:textColorHint="@color/phosphor_text_ghost"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:inputType="textPassword"
        android:singleLine="true"
        android:backgroundTint="@color/phosphor_dim" />

</LinearLayout>
